# IronGraph-Engine Environment Variables Example
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration
POSTGRES_USER=irongraph
POSTGRES_PASSWORD=irongraph_secret
POSTGRES_DB=irongraph_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://irongraph:irongraph_secret@localhost:5432/irongraph_db

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Store
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Foundation Model Providers
LLM_PRIMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
